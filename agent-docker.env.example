# ==============================================================================
# Agent Docker Sandbox Configuration Template
# ==============================================================================
# Copy this file to 'agent-docker.env' to customize your build settings:
#   cp agent-docker.env.example agent-docker.env
#
# Set each variable to 'true' to install the agent during docker build, or 'false' to skip.
# After editing, apply changes by running:
#   agent-docker --build
# ==============================================================================

# Google Antigravity CLI (agy)
INSTALL_AGY=true

# Anthropic Claude Code CLI (claude)
INSTALL_CLAUDE=false

# OpenAI Codex CLI (codex)
INSTALL_CODEX=false

# OpenCode CLI (opencode)
INSTALL_OPENCODE=false

# Hermes Agent (hermes)
INSTALL_HERMES=false

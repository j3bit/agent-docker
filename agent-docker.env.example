# ==============================================================================
# Agent Docker Sandbox Configuration Template
# ==============================================================================
# Copy this file to 'agent-docker.env' to customize your build settings:
#   cp agent-docker.env.example agent-docker.env
#
# Set each variable to 'true' to install the agent during docker build, or 'false' to skip.
# After editing, apply changes by running:
#   agent-docker --build
# ==============================================================================

# Google Antigravity CLI (agy)
INSTALL_AGY=true

# Anthropic Claude Code CLI (claude)
INSTALL_CLAUDE=false

# OpenAI Codex CLI (codex)
INSTALL_CODEX=false

# OpenCode CLI (opencode)
INSTALL_OPENCODE=false

# Hermes Agent (hermes)
INSTALL_HERMES=false

# ------------------------------------------------------------------------------
# Authentication
# ------------------------------------------------------------------------------
# Claude Code normally reuses the host login: the sandbox mounts ~/.claude, and
# the OAuth token lives in ~/.claude/.credentials.json. If that file only holds
# an "mcpOAuth" entry (macOS can keep the login in the Keychain instead), the
# container starts with "Not logged in".
#
# Set a long-lived token here to make authentication deterministic. Generate it
# once on the host with:
#
#   claude setup-token
#
# Leave empty to rely on the mounted credentials, or to run /login inside the
# container once (the result is remembered in state/claude.json).
CLAUDE_CODE_OAUTH_TOKEN=
